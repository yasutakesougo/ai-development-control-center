{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-development-control-center",
  "compatibility_date": "2026-08-11",
  "main": "src/worker/index.ts",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // AC7: Main Worker has service-call capability only. It has no Production
  // Authority D1 binding, no Receipt private key, and no deploy credential.
  "services": [
    {
      "binding": "AUTHORITY_RECORDER",
      "service": "authority-recorder"
    },
    {
      "binding": "AUTHORITY_EXECUTOR",
      "service": "authority-execution-enforcer"
    }
  ],
  "env": {
    // Isolated staging pilot (MVP-3-APPROVAL-LEDGER-STAGING-PILOT-V1).
    // This legacy LEDGER_DB is decision-support history (Record != Authority)
    // and is NOT the AC7 production Authority Store.
    "staging": {
      "name": "ai-development-control-center-staging",
      "assets": {
        "binding": "ASSETS",
        "not_found_handling": "single-page-application"
      },
      "d1_databases": [
        {
          "binding": "LEDGER_DB",
          "database_name": "ai-development-control-center-ledger-staging",
          "database_id": "59e85eae-74ec-4742-866e-94e9c8cf5fd6"
        }
      ],
      "vars": {
        "LEDGER_AUTHZ_MODE": "access-policy",
        "ACCESS_TEAM_DOMAIN": "https://momosantanuki.cloudflareaccess.com",
        "ACCESS_AUD": "91270b9e145b0e0501447707795d6a75d7622c141da082e72d77c4fa02e1ac3c"
      }
    }
  }
}
