{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-development-control-center.local/schemas/roadmap-contract-v1.json",
  "title": "RoadmapContractV1",
  "description": "Machine-readable dependency-aware roadmap DAG bound to ProjectContractV1. Runtime parser must mirror this schema (additionalProperties:false). metadata/observedAt are audit-only and excluded from the authority fingerprint. Semantic DAG rules (cycles, missing deps, project binding) are enforced at runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "roadmapId",
    "projectId",
    "projectAuthorityFingerprint",
    "nodes"
  ],
  "properties": {
    "schemaVersion": { "const": "ROADMAP-CONTRACT-V1" },
    "roadmapId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "projectAuthorityFingerprint": {
      "description": "Exact ProjectContractV1 authority fingerprint binding (64-char lowercase SHA-256 hex).",
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nodeId",
          "title",
          "objective",
          "phase",
          "dependsOn",
          "completionCriteria",
          "estimatedComplexity",
          "status"
        ],
        "properties": {
          "nodeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
          },
          "title": { "type": "string", "minLength": 1, "maxLength": 256 },
          "objective": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "phase": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
          },
          "dependsOn": {
            "description": "nodeId references. Runtime rejects missing refs, self-deps, duplicates, and cycles.",
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
            },
            "uniqueItems": true
          },
          "completionCriteria": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": { "type": "string", "minLength": 1, "maxLength": 2048 },
            "uniqueItems": true
          },
          "estimatedComplexity": {
            "enum": ["XS", "S", "M", "L", "XL"]
          },
          "status": {
            "enum": [
              "PLANNED",
              "READY",
              "IN_PROGRESS",
              "BLOCKED",
              "COMPLETE",
              "HOLD",
              "UNKNOWN"
            ]
          },
          "repository": {
            "description": "Optional repository binding. When present, runtime requires membership in ProjectContractV1.repositories.",
            "type": "string",
            "minLength": 3,
            "maxLength": 256,
            "pattern": "^[a-zA-Z0-9._-]+/[a-zA-Z0-9._-]+$"
          }
        }
      }
    },
    "metadata": {
      "description": "Audit / observation fields only. observedAt and other metadata MUST NOT participate in the authority fingerprint.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "createdAt": { "type": "string", "minLength": 1, "maxLength": 64 },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 256 },
        "observedAt": { "type": "string", "minLength": 1, "maxLength": 64 },
        "sourceIssueUrl": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "notes": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        }
      }
    }
  }
}
